<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="GameDirectory" value="" />
    <add key="ModIoDirectory" value="" />
    <add key="GameSettingsDirectory" value="" />
    <add key="ModsDirectory" />
    <add key="IgnoreModNames" />
    <add key="CollapseIdenticalConflicts" value="True" />
    <add key="CollapseCustomLoadOrder" value="False" />
    <add key="CollapseNotMergeable" value="False" />
    <add key="ReviewEachMerge" value="False" />
    <add key="ReportAfterMerge" value="False" />
    <add key="ReportAfterPack" value="True" />
    <add key="AutoCreateScriptMerges" value="False" />
    <add key="AutoDeleteOldMerges" value="True" />
    <add key="AutoOverwriteOldMerges" value="True" />
    <add key="AutoSkipKDiff3InfoDialogs" value="True" />
    <add key="AutoExit" value="False" />
    <add key="CheckForApplicationUpdates" value="True" />
    <add key="ColorTheme" value="0" />
    <add key="UiLanguage" value="en" />
    <add key="ConflictListFontSize" value="12" />
    <add key="AccentColor" value="True" />
    <add key="CustomAccentColor" value="0A84FF" />
    <add key="PrioToolTips" value="3" />
    <add key="RanThroughVortex" value="false" />
    <add key="MergedModName" value="mod0000_MergedFiles" />
    <add key="KDiff3Path" value="Tools\KDiff3\KDiff3.exe" />
    <add key="WccLitePath" value="" />
    <add key="StartMaximized" value="False" />
    <add key="StartWidth" value="0" />
    <add key="StartHeight" value="0" />
    <add key="StartPosTop" value="0" />
    <add key="StartPosLeft" value="0" />
    <add key="ClientSettingsProvider.ServiceUri" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>
